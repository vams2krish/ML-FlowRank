# Use a dedicated, least-privilege Postgres login; never a Supabase service key.
DATABASE_URL=
# Without DATABASE_URL, development uses local SQLite.
FLOWRANK_SQLITE=data/product.db
COOKIE_SECURE=false
# SHA-256 of a high-entropy admin bearer token. Blank disables admin endpoints.
ADMIN_TOKEN_HASH=
# Random bearer credential for Vercel's daily retention job.
CRON_SECRET=
